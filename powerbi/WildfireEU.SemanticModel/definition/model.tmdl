model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["dim_date","dim_country","dim_commune","dim_landcover","dim_firecause","dim_source","fact_fireevent","fact_burntarea_countrymonth","fact_burntarea_countryyear","fact_burntarea_landcover","fact_fireweather_countrymonth","fact_hotspot_countrymonth","tail_risk_country","tail_risk_levels","tail_risk_threshold_stability","attribution_countryyear","attribution_coefficients","attribution_summary","attribution_robustness","attribution_exclusions","q1_metrics","q1_criterion","q1_importance","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref expression DataFolder

ref table dim_date
ref table dim_country
ref table dim_commune
ref table dim_landcover
ref table dim_firecause
ref table dim_source
ref table fact_fireevent
ref table fact_burntarea_countrymonth
ref table fact_burntarea_countryyear
ref table fact_burntarea_landcover
ref table fact_fireweather_countrymonth
ref table fact_hotspot_countrymonth
ref table tail_risk_country
ref table tail_risk_levels
ref table tail_risk_threshold_stability
ref table attribution_countryyear
ref table attribution_coefficients
ref table attribution_summary
ref table attribution_robustness
ref table attribution_exclusions
ref table q1_metrics
ref table q1_criterion
ref table q1_importance
ref table _Measures
ref table Metric
ref table 'Time calculation'

ref cultureInfo en-GB

