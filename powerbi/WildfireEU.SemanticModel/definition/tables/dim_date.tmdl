		dataType: int64
		lineageTag: 8c88f400-4ef5-4166-bc8c-07305dc649be
		summarizeBy: none
		sourceColumn: quarter

		annotation SummarizationSetBy = Automatic

	column month
		dataType: int64
		lineageTag: 2fea6b6a-ebb5-40af-8e0e-273a730bb729
		summarizeBy: none
		sourceColumn: month

		annotation SummarizationSetBy = Automatic

	column month_name
		dataType: string
		lineageTag: 013780a5-3c31-4e18-9ca8-2e27c7df66a7
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

		annotation SummarizationSetBy = Automatic

