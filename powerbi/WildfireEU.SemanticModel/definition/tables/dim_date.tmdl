table dim_date
	lineageTag: cde4ce17-8116-4924-a023-45a7faf4c687
	dataCategory: Time

	column date_key
		dataType: dateTime
		isHidden
		isKey
		formatString: Long Date
		lineageTag: 2f74a88f-663a-4be2-9273-0b2cfbc78fe0
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		lineageTag: 9c57031b-2a73-4d01-95ed-52524328abb1
		summarizeBy: none
		sourceColumn: year

