table _Measures
	lineageTag: 9a3e5b10-0000-4a00-9a01-000000000000

	measure 'Burnt Area (ha)' = SUM(fact_burntarea_countrymonth[burnt_area_ha])
		formatString: #,##0
		displayFolder: Surfaces et feux
		lineageTag: 9a3e5b10-0001-4a00-9a01-000000000001

	measure 'Number of Fires' = SUM(fact_burntarea_countrymonth[number_of_fires])
		formatString: #,##0
		displayFolder: Surfaces et feux
		lineageTag: 9a3e5b10-0001-4a00-9a01-000000000002

	measure 'CO2 Emissions (t)' =
			
			// Emissions come from GWIS/GFAS only, which sits on its own rows in
			// fact_burntarea_countryyear (source_key = "GWIS_GFAS") so that GFAS
			// tonnes are never attributed to EFFIS or BDIFF. A page filtered to a
			// burnt-area source would therefore return blank; REMOVEFILTERS on
			// dim_source states that this measure has exactly one source and does
			// not respond to a source selection.
			CALCULATE (
			    SUM ( fact_burntarea_countryyear[co2_emissions_t] ),
			    REMOVEFILTERS ( dim_source )
			)
		formatString: #,##0
		displayFolder: Surfaces et feux
		lineageTag: 9a3e5b10-0001-4a00-9a01-000000000003

	measure 'Avg Fire Size (ha)' = DIVIDE([Burnt Area (ha)], [Number of Fires])
		formatString: #,##0.0
		displayFolder: Surfaces et feux
		lineageTag: 9a3e5b10-0001-4a00-9a01-000000000004

	measure 'Burnt Area, landcover (ha)' = SUM(fact_burntarea_landcover[burnt_area_ha])
		formatString: #,##0
		displayFolder: Surfaces et feux
		lineageTag: 9a3e5b10-0001-4a00-9a01-000000000005

	measure 'Fire Events' = COUNTROWS(fact_fireevent)
		formatString: #,##0
		displayFolder: Grain feu
		lineageTag: 9a3e5b10-0002-4a00-9a01-000000000001

	measure 'Burnt Area, events (ha)' = SUM(fact_fireevent[Area (ha)])
		formatString: #,##0
		displayFolder: Grain feu
		lineageTag: 9a3e5b10-0002-4a00-9a01-000000000002

	measure 'Median Fire Size (ha)' = MEDIAN(fact_fireevent[Area (ha)])
		formatString: #,##0.00
		displayFolder: Grain feu
		lineageTag: 9a3e5b10-0002-4a00-9a01-000000000003

	measure 'Largest Fire (ha)' = MAX(fact_fireevent[Area (ha)])
		formatString: #,##0
		displayFolder: Grain feu
		lineageTag: 9a3e5b10-0002-4a00-9a01-000000000004

	measure 'Burnt Area PY' = CALCULATE([Burnt Area (ha)], SAMEPERIODLASTYEAR(dim_date[date_key]))
		formatString: #,##0
		displayFolder: Time intelligence
		lineageTag: 9a3e5b10-0003-4a00-9a01-000000000001

	measure 'Burnt Area YoY %' = DIVIDE([Burnt Area (ha)] - [Burnt Area PY], [Burnt Area PY])
		formatString: +0.0%;-0.0%
		displayFolder: Time intelligence
		lineageTag: 9a3e5b10-0003-4a00-9a01-000000000002

	measure 'Burnt Area YTD' = TOTALYTD([Burnt Area (ha)], dim_date[date_key])
		formatString: #,##0
		displayFolder: Time intelligence
		lineageTag: 9a3e5b10-0003-4a00-9a01-000000000003

	measure 'Burnt Area, 5Y avg' =
			
			// Trailing 5-year annual baseline, current year excluded, so it reads as
			// "the normal" against which the current year is judged.
			// The previous definition averaged over DATESINPERIOD's *daily* table.
			// Facts sit at month grain (only the month's first day carries a value),
			// so AVERAGEX skipped ~29 blank days per month and returned a MONTHLY
			// mean plotted next to ANNUAL totals: an order-of-magnitude mismatch
			// that flattened the baseline onto the axis.
			VAR CurYear = MAX ( dim_date[year] )
			VAR PriorYears =
			    FILTER (
			        ALL ( dim_date[year] ),
			        dim_date[year] < CurYear && dim_date[year] >= CurYear - 5
			    )
			RETURN
			    AVERAGEX ( PriorYears, CALCULATE ( [Burnt Area (ha)] ) )
		formatString: #,##0
		displayFolder: Time intelligence
		lineageTag: 9a3e5b10-0003-4a00-9a01-000000000004

	measure 'Burnt Area, season-to-date' =
			
			// Cumulative burnt area from 1 January to the day-of-year in context.
			//
			// The curve must STOP at the last month that carries data, not run
			// flat to day 365. Facts sit at month grain, so without the guard
			// below every day after the last fact month repeated the year's total
			// and the running year drew a long horizontal line across the rest of
			// the calendar: read as "the season finished at this total" when it
			// means "we have no data yet". Measured 2026-07-31, 2026 plateaued at
			// 1 106 101 ha from day 211 all the way to day 361.
			// The guard only applies when day-of-year is actually on an axis, so
			// the season-to-date CARD (no day-of-year in scope) still returns the
			// full total rather than going blank.
			VAR CurYear = MAX ( dim_date[year] )
			VAR MaxDoY = MAX ( dim_date[day_of_year] )
			VAR LastFactMonth =
			    CALCULATE (
			        MAX ( fact_burntarea_countrymonth[month_key] ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] = CurYear
			    )
			VAR LastCoveredDoY =
			    IF (
			        NOT ISBLANK ( LastFactMonth ),
			        DATEDIFF ( DATE ( CurYear, 1, 1 ), EOMONTH ( LastFactMonth, 0 ), DAY ) + 1
			    )
			VAR Cumulative =
			    CALCULATE (
			        [Burnt Area (ha)],
			        FILTER ( ALL ( dim_date ), dim_date[year] = CurYear && dim_date[day_of_year] <= MaxDoY )
			    )
			RETURN
			    IF (
			        NOT ISINSCOPE ( dim_date[day_of_year] ) || MaxDoY <= LastCoveredDoY,
			        Cumulative
			    )
		formatString: #,##0
		displayFolder: Saisonnalité
		lineageTag: 9a3e5b10-0004-4a00-9a01-000000000001

	measure 'Mean FWI' = AVERAGE(fact_fireweather_countrymonth[mean_fwi])
		formatString: #,##0.0
		displayFolder: Météo-feu
		lineageTag: 9a3e5b10-0005-4a00-9a01-000000000001

	measure 'Max FWI' = MAX(fact_fireweather_countrymonth[max_fwi])
		formatString: #,##0.0
		displayFolder: Météo-feu
		lineageTag: 9a3e5b10-0005-4a00-9a01-000000000002

	measure 'Days High Danger' = SUM(fact_fireweather_countrymonth[days_fwi_high])
		formatString: #,##0
		displayFolder: Météo-feu
