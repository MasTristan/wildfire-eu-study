	measure 'Hotspot Count' = SUM(fact_hotspot_countrymonth[hotspot_count])
		formatString: #,##0
		displayFolder: Hotspots
		lineageTag: 9a3e5b10-0006-4a00-9a01-000000000001

	measure 'Mean FRP (MW)' = AVERAGE(fact_hotspot_countrymonth[mean_frp])
		formatString: #,##0.0
		displayFolder: Hotspots
